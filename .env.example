# Copy to .env and fill in. Everything is optional for local development:
# the app uses SQLite (db.sqlite3) and stores uploads in ./media by default.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Extra comma-separated hosts (Render's own hostname is added automatically)
ALLOWED_HOSTS=
LOG_LEVEL=INFO

# --- Storage locations ---
# On Render, mount a persistent disk (e.g. at /var/data) and point these at it,
# otherwise the database and uploads are wiped on every deploy/restart.
# SQLITE_PATH=/var/data/db.sqlite3
# MEDIA_ROOT=/var/data/media

# --- Optional: use PostgreSQL instead of SQLite ---
# DATABASE_URL=postgresql://user:password@host:5432/dbname
